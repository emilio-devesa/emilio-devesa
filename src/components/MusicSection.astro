---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Section from './Section.astro';
import StreamLinks from './StreamLinks.astro';
import artwork05 from '../assets/images/artwork05.png';
import artwork04 from '../assets/images/artwork04.png';
import artwork03 from '../assets/images/artwork03.png';
import artwork02 from '../assets/images/artwork02.png';
import artwork01 from '../assets/images/artwork01.png';

interface PlatformLinks {
  spotify: string;
  apple: string;
  amazon: string;
}

interface Album {
  img: ImageMetadata;
  alt: string;
  title: string;
  text: string;
  links: PlatformLinks;
  reverse?: boolean;
}

interface Collab {
  img: ImageMetadata;
  alt: string;
  title: string;
  artist: string;
  detail: string;
  links: PlatformLinks;
}

const albums: Album[] = [
  {
    img: artwork05,
    alt: 'Euphoria, Carlos Campoy',
    title: '"Euphoria", Carlos Campoy, RockCD Records 2021',
    text: 'Carlos Campoy ha contado conmigo para tocar la batería en todos los temas de su disco "Euphoria". La grabación del álbum se realizó en RR Studios (Ferrol) y la postproducción en Metromastering (A Coruña). Además participo en la gira española de conciertos "Euphoria Live Tour". El single "Lúa" fue seleccionado y emitido en el Yamaha Teacher\'s Forum Live 2023 en Japón.',
    links: {
      spotify: 'https://open.spotify.com/album/4uUvcv5ecb2S5blrco8eyY?si=wqVOIipfTSyKDdlUTjerZg',
      apple: 'https://music.apple.com/es/album/euphoria/1568780017',
      amazon: 'https://music.amazon.es/albums/B095L3NJ37',
    },
  },
  {
    img: artwork04,
    alt: 'Ríos de Albariño, Tatilari',
    title: '"Ríos de Albariño", Tatilari, Independiente 2021',
    text: 'He tenido el privilegio de tocar la batería en esta canción pop inspirada en la Fiesta del Albariño de Cambados. También me encargué de la grabación y mezcla de los demás instrumentos, así como de la voz de Tatilari, una talentosa artista vasca con influencias gallegas. El mastering estuvo a cargo de Santi Quizhpe.',
    links: {
      spotify: 'https://open.spotify.com/album/4edVmvN3aJlJTpJlsM7bW5?si=FFvwKs4iRWOIrWjh9gLB0w',
      apple: 'https://music.apple.com/es/album/r%C3%ADos-de-albari%C3%B1o-single/1570274714',
      amazon: 'https://music.amazon.es/albums/B096BMPS9S',
    },
    reverse: true,
  },
];

const collabs: Collab[] = [
  {
    img: artwork03,
    alt: 'Monstros con ou sen consentimento',
    title: 'Monstros con ou sen consentimento',
    artist: 'Chuches Amil',
    detail: 'Galaxia 2018',
    links: {
      spotify: 'https://open.spotify.com/album/4L9ND9Cb6CIIRZEXmis2yP?si=cq-6sOCaRGKZs5MD0KgiwQ',
      apple: 'https://music.apple.com/es/album/monstros-con-ou-sen-consentimento/1405051787',
      amazon: 'https://music.amazon.es/albums/B07N2HNS36',
    },
  },
  {
    img: artwork02,
    alt: 'Un Conto ao Revés',
    title: 'Un Conto ao Revés',
    artist: 'Chuches Amil',
    detail: 'Galaxia 2015',
    links: {
      spotify: 'https://open.spotify.com/album/6rMZ09HzJ7Whpndq9gpqpj?si=bqI2K9MwTaKWW9Zh0coUkg',
      apple: 'https://music.apple.com/es/album/un-conto-ao-rev%C3%A9s/1005680529',
      amazon: 'https://music.amazon.es/albums/B01077K9J2',
    },
  },
  {
    img: artwork01,
    alt: 'Escándalo en Bohemia',
    title: 'Escándalo en Bohemia',
    artist: 'Los Wattsons',
    detail: 'Luscomática 2014',
    links: {
      spotify: 'https://open.spotify.com/album/6Pa4oombvRPDngASi2NZp6?si=xAnQtIlxT6mM6Y_GPQZ0iw',
      apple: 'https://music.apple.com/es/album/escandalo-en-bohemia/797595581',
      amazon: 'https://music.amazon.es/albums/B00I0TNHT4',
    },
  },
];
---

<Section id="music" icon="💿" title="Discografía y colaboraciones">
  <h3>Discografía</h3>
  {albums.map((album) => (
    <div class:list={['album', { reverse: album.reverse }]}>
      <Image src={album.img} alt={album.alt} width={300} loading="lazy" />
      <div class="album-info">
        <h4>{album.title}</h4>
        <p>{album.text}</p>
        <StreamLinks links={album.links} />
      </div>
    </div>
  ))}

  <h3>Colaboraciones</h3>
  <div class="collab-grid">
    {collabs.map((collab) => (
      <div class="collab-item">
        <Image src={collab.img} alt={collab.alt} width={300} loading="lazy" />
        <h4>{collab.title}</h4>
        <p>
          {collab.artist}, {collab.detail}
        </p>
        <StreamLinks links={collab.links} />
      </div>
    ))}
  </div>
</Section>
