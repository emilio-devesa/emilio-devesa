---
interface StreamLinks {
  spotify: string;
  apple: string;
  amazon: string;
}

interface Album {
  img: string;
  alt: string;
  title: string;
  text: string;
  links: StreamLinks;
  reverse?: boolean;
}

interface Collab {
  img: string;
  alt: string;
  title: string;
  meta: string;
  links: StreamLinks;
}

const albums: Album[] = [
  {
    img: '/images/artwork/artwork05.png',
    alt: 'Euphoria, Carlos Campoy',
    title: '"Euphoria", Carlos Campoy, RockCD Records 2021',
    text: 'Carlos Campoy ha contado conmigo para tocar la batería en todos los temas de su disco "Euphoria". La grabación del álbum se realizó en RR Studios (Ferrol) y la postproducción en Metromastering (A Coruña). Además participo en la gira española de conciertos "Euphoria Live Tour". El single "Lúa" fue seleccionado y emitido en el Yamaha Teacher\'s Forum Live 2023 en Japón.',
    links: {
      spotify:
        'https://open.spotify.com/album/4uUvcv5ecb2S5blrco8eyY?si=wqVOIipfTSyKDdlUTjerZg',
      apple: 'https://music.apple.com/es/album/euphoria/1568780017',
      amazon: 'https://music.amazon.es/albums/B095L3NJ37',
    },
  },
  {
    img: '/images/artwork/artwork04.png',
    alt: 'Ríos de Albariño, Tatilari',
    title: '"Ríos de Albariño", Tatilari, Independiente 2021',
    text: 'He tenido el privilegio de tocar la batería en esta canción pop inspirada en la Fiesta del Albariño de Cambados. También me encargué de la grabación y mezcla de los demás instrumentos, así como de la voz de Tatilari, una talentosa artista vasca con influencias gallegas. El mastering estuvo a cargo de Santi Quizhpe.',
    links: {
      spotify:
        'https://open.spotify.com/album/4edVmvN3aJlJTpJlsM7bW5?si=FFvwKs4iRWOIrWjh9gLB0w',
      apple:
        'https://music.apple.com/es/album/r%C3%ADos-de-albari%C3%B1o-single/1570274714',
      amazon: 'https://music.amazon.es/albums/B096BMPS9S',
    },
    reverse: true,
  },
];

const collabs: Collab[] = [
  {
    img: '/images/artwork/artwork03.png',
    alt: 'Monstros con ou sen consentimento',
    title: 'Monstros con ou sen consentimento',
    meta: 'Chuches Amil, Galaxia 2018',
    links: {
      spotify:
        'https://open.spotify.com/album/4L9ND9Cb6CIIRZEXmis2yP?si=cq-6sOCaRGKZs5MD0KgiwQ',
      apple:
        'https://music.apple.com/es/album/monstros-con-ou-sen-consentimento/1405051787',
      amazon: 'https://music.amazon.es/albums/B07N2HNS36',
    },
  },
  {
    img: '/images/artwork/artwork02.png',
    alt: 'Un Conto ao Revés',
    title: 'Un Conto ao Revés',
    meta: 'Chuches Amil, Galaxia 2015',
    links: {
      spotify:
        'https://open.spotify.com/album/6rMZ09HzJ7Whpndq9gpqpj?si=bqI2K9MwTaKWW9Zh0coUkg',
      apple:
        'https://music.apple.com/es/album/un-conto-ao-rev%C3%A9s/1005680529',
      amazon: 'https://music.amazon.es/albums/B01077K9J2',
    },
  },
  {
    img: '/images/artwork/artwork01.png',
    alt: 'Escándalo en Bohemia',
    title: 'Escándalo en Bohemia',
    meta: 'Los Wattsons, Luscomática 2014',
    links: {
      spotify:
        'https://open.spotify.com/album/6Pa4oombvRPDngASi2NZp6?si=xAnQtIlxT6mM6Y_GPQZ0iw',
      apple: 'https://music.apple.com/es/album/escandalo-en-bohemia/797595581',
      amazon: 'https://music.amazon.es/albums/B00I0TNHT4',
    },
  },
];

const linkLabels: { key: keyof StreamLinks; label: string }[] = [
  { key: 'spotify', label: 'Spotify' },
  { key: 'apple', label: 'Apple Music' },
  { key: 'amazon', label: 'Amazon Music' },
];
---

<section id="music">
  <h2>💿 Discografía y colaboraciones</h2>

  <h3>Discografía</h3>
  {
    albums.map((album) => (
      <div class:list={['album', { reverse: album.reverse }]}>
        <img loading="lazy" src={album.img} alt={album.alt} width="300" height="300" />
        <div class="album-info">
          <h4>{album.title}</h4>
          <p>{album.text}</p>
          <div class="links">
            {linkLabels.map(({ key, label }) => (
              <a href={album.links[key]} target="_blank" rel="noopener">
                {label}
              </a>
            ))}
          </div>
        </div>
      </div>
    ))
  }

  <h3>Colaboraciones</h3>
  <div class="collab-grid">
    {
      collabs.map((collab) => (
        <div class="collab-item">
          <img loading="lazy" src={collab.img} alt={collab.alt} width="300" height="300" />
          <p>
            <i>{collab.title}</i>
            <br />
            {collab.meta}
          </p>
          <div class="links">
            {linkLabels.map(({ key, label }) => (
              <a href={collab.links[key]} target="_blank" rel="noopener">
                {label}
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
