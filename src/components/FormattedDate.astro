---
interface Props {
  date: Date;
}

const { date } = Astro.props;
// Mediodía UTC: la fecha visible coincide con la del front-matter en
// cualquier huso horario (sin el desfase de la medianoche UTC).
const noon = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate(), 12));
---

<time datetime={noon.toISOString().slice(0, 10)}>
  {noon.toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })}
</time>
