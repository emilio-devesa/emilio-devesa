---
interface Props {
  date: Date;
  // Idioma del texto: 'en' para los posts en inglés, 'es' por defecto.
  lang?: string;
}

const { date, lang = 'es' } = Astro.props;
// Mediodía UTC: la fecha visible coincide con la del front-matter en
// cualquier huso horario (sin el desfase de la medianoche UTC).
const noon = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate(), 12));
// en-GB mantiene el orden día-mes-año del sitio (y solo cambia la mayúscula del mes).
const locale = lang === 'en' ? 'en-GB' : 'es-ES';
---

<time datetime={noon.toISOString().slice(0, 10)}>
  {noon.toLocaleDateString(locale, {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })}
</time>
