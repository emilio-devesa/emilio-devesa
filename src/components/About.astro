---
import { Image } from 'astro:assets';
import profile from '../assets/images/profile.png';

const paragraphs = [
  {
    icon: '🙋🏻‍♂️',
    text: 'Soy Emilio Devesa, batería profesional, profesor certificado por Yamaha Music Europe y cuento con una sólida experiencia como intérprete y docente.',
  },
  {
    icon: '🌍',
    text: 'Llevo más de 15 años trabajando como músico de directo, músico de sesión y profesor de batería.',
  },
  {
    icon: '💿',
    text: 'También he producido varios trabajos para otros artistas y colaborado con muchos proyectos de estilos muy variados.',
  },
  {
    icon: '🎓',
    text: 'Además soy Key Teacher oficial del sistema Yamaha Music Education.',
  },
];
---

<section id="sobre-mi">
  <h2>
    <span aria-hidden="true">👋🏾</span> Quién soy
  </h2>
  <div class="about-grid">
    <div class="about-text">
      {paragraphs.map((p) => (
        <p>
          <span aria-hidden="true">{p.icon}</span> {p.text}
        </p>
      ))}
    </div>
    <div class="about-image">
      <Image src={profile} alt="Emilio Devesa tocando la batería" width={300} loading="lazy" />
    </div>
  </div>
</section>
