---
const paragraphs = [
  '🙋🏻‍♂️ Soy Emilio Devesa, batería profesional, profesor certificado por Yamaha Music Europe y cuento con una sólida experiencia como intérprete y docente.',
  '🌍 Llevo más de 15 años trabajando como músico de directo, músico de sesión y profesor de batería.',
  '💿 También he producido varios trabajos para otros artistas y colaborado con muchos proyectos de estilos muy variados.',
  '🎓 Además soy Key Teacher oficial del sistema Yamaha Music Education.',
];
---

<section id="sobre-mi">
  <h2>👋🏾 Quién soy</h2>
  <div class="about-grid">
    <div class="about-text">
      {paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>
    <div class="about-image">
      <img
        src="/images/profile.png"
        alt="Emilio Devesa tocando la batería"
        width="300"
        height="300"
        loading="lazy"
      />
    </div>
  </div>
</section>
