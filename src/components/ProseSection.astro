---
interface Props {
  id: string;
  icon?: string;
  title?: string;
}

const { id, icon, title } = Astro.props;
// Sin título no hay encabezado que nombre la región: un <section>
// anónimo es ruido para lectores de pantalla, así que se usa <div>.
const Tag = title ? 'section' : 'div';
---

<Tag id={id}>
  {title ? (
    <h2>
      {icon ? (
        <>
          <span aria-hidden="true">{icon}</span>{' '}
        </>
      ) : null}
      {title}
    </h2>
  ) : null}
  <div class="prose-wrap">
    <div class="article-content">
      <slot />
    </div>
  </div>
</Tag>
