---
interface Props {
  id: string;
  icon?: string;
  title?: string;
}

const { id, icon, title } = Astro.props;
---

<section id={id}>
  {title ? (
    <h2>
      {icon ? (
        <>
          <span aria-hidden="true">{icon}</span>{' '}
        </>
      ) : null}
      {title}
    </h2>
  ) : null}
  <div class="prose-wrap">
    <div class="article-content">
      <slot />
    </div>
  </div>
</section>
