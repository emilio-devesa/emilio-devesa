---
interface Card {
  icon?: string;
  title: string;
  iconEnd?: string;
  description: string;
}

interface Cta {
  text: string;
  url: string;
}

interface Props {
  id: string;
  icon?: string;
  title: string;
  cards: Card[];
  cta: Cta[];
}

const { id, icon, title, cards, cta } = Astro.props;
---

<section id={id}>
  <h2>
    {icon ? (
      <>
        <span aria-hidden="true">{icon}</span>{' '}
      </>
    ) : null}
    {title}
  </h2>
  <div class="offers">
    {cards.map((card) => (
      <div class="offer">
        <h3>
          {card.icon ? (
            <>
              <span aria-hidden="true">{card.icon}</span>{' '}
            </>
          ) : null}
          {card.title}
          {card.iconEnd ? (
            <>
              {' '}
              <span aria-hidden="true">{card.iconEnd}</span>
            </>
          ) : null}
        </h3>
        <p>{card.description}</p>
      </div>
    ))}
  </div>

  <div class="cta-row">
    <ul>
      {cta.map((button) => (
        <li>
          <a class="cta" href={button.url}>
            {button.text}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
