---
import Section from './Section.astro';
import CtaRow from './CtaRow.astro';

interface Card {
  icon?: string;
  title: string;
  iconEnd?: string;
  description: string;
}

interface Cta {
  text: string;
  url: string;
}

interface Props {
  id: string;
  icon?: string;
  title: string;
  cards: Card[];
  cta: Cta[];
}

const { id, icon, title, cards, cta } = Astro.props;
---

<Section id={id} icon={icon} title={title}>
  <div class="offers">
    {cards.map((card) => (
      <div class="offer">
        <h3>
          {card.icon ? (
            <>
              <span aria-hidden="true">{card.icon}</span>{' '}
            </>
          ) : null}
          {card.title}
          {card.iconEnd ? (
            <>
              {' '}
              <span aria-hidden="true">{card.iconEnd}</span>
            </>
          ) : null}
        </h3>
        <p>{card.description}</p>
      </div>
    ))}
  </div>
  <CtaRow links={cta} />
</Section>
