---
import NavLinks from './NavLinks.astro';

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  links: NavLink[];
  ariaLabel?: string;
  idPrefix?: string;
}

const { links, ariaLabel = 'Navegación principal', idPrefix = 'site' } = Astro.props;
const stateId = `${idPrefix}-menu-state`;
const navId = `${idPrefix}-nav-links`;
---

<header>
  <a class="skip-link" href="#main-content">
    Saltar al contenido
  </a>
  <nav aria-label={ariaLabel}>
    <a href="/">Emilio Devesa</a>
    <button
      type="button"
      class="menu-toggle"
      popovertarget={stateId}
      aria-label="Menú"
      aria-controls={navId}
    ></button>

    <NavLinks links={links} className="nav-links nav-links--desktop" />

    {/* Menú sin JS (Popover API). En móvil el popover es el propio panel y
        contiene los enlaces: así, al pulsar un enlace, el navegador no lo
        considera un clic fuera del popover y no dispara el light dismiss que
        cerraba el menú antes de procesar el clic. Va después del botón para
        que el orden de foco sea natural; el glifo ☰/✕ se actualiza con :has.
        En escritorio este panel está cerrado y se usa .nav-links--desktop.
        Sin JS, un enlace de ancla de la misma página no recarga y el panel
        permanece abierto; se cierra con ✕, Escape o tocando fuera. */}
    <div popover data-menu-state id={stateId} class="menu-panel">
      <NavLinks links={links} id={navId} />
    </div>
  </nav>
</header>
