---
import ExternalHint from './ExternalHint.astro';

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  links: NavLink[];
  ariaLabel?: string;
  idPrefix?: string;
}

const { links, ariaLabel = 'Navegación principal', idPrefix = 'site' } = Astro.props;
const stateId = `${idPrefix}-menu-state`;
const navId = `${idPrefix}-nav-links`;
---

<header>
  <a class="skip-link" href="#main-content">
    Saltar al contenido
  </a>
  <nav aria-label={ariaLabel}>
    {/* Menú sin JS (Popover API). Esta pastilla vacía e invisible es el
        <div popover>: el botón la abre/cierra con popovertarget y el combinador
        (ver style.css) enseña .nav-links cuando está abierta. Va ANTES del
        botón y de .nav-links para que el selector ~ los alcance. Es `inert` y
        de tamaño cero, así que queda fuera del orden de tabulación y del
        diseño; el navegador la oculta mientras está cerrada. */}
    <div popover inert data-menu-state id={stateId}></div>
    <a href="/">Emilio Devesa</a>
    <button
      type="button"
      class="menu-toggle"
      popovertarget={stateId}
      aria-label="Menú"
      aria-controls={navId}
    ></button>

    <div class="nav-links" id={navId}>
      {links.map((link) =>
        link.href.startsWith('http') ? (
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
            <ExternalHint />
          </a>
        ) : (
          <a href={link.href}>{link.label}</a>
        ),
      )}
    </div>
  </nav>
</header>
