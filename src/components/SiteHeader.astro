---
interface NavLink {
  href: string;
  label: string;
}

interface Props {
  links: NavLink[];
  ariaLabel?: string;
  idPrefix?: string;
}

const { links, ariaLabel = 'Navegación principal', idPrefix = 'site' } = Astro.props;
const toggleId = `${idPrefix}-menu-toggle`;
const navId = `${idPrefix}-nav-links`;
---

<header>
  <a class="skip-link" href="#main-content">
    Saltar al contenido
  </a>
  <nav aria-label={ariaLabel}>
    <a href="/">Emilio Devesa</a>
    <button
      class="menu-toggle"
      id={toggleId}
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls={navId}
    >
      ☰
    </button>

    <div class="nav-links" id={navId}>
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </div>
  </nav>

  <noscript>
    <style>
      .menu-toggle {
        display: none;
      }
      @media (max-width: 768px) {
        header nav {
          flex-wrap: wrap;
        }
        .nav-links {
          display: flex;
          flex-direction: column;
          width: 100%;
          margin-top: 1rem;
        }
      }
    </style>
  </noscript>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('header').forEach(function (header) {
        const toggle = header.querySelector('.menu-toggle');
        const nav = header.querySelector('.nav-links');
        if (!toggle || !nav) return;
        toggle.addEventListener('click', () => {
          const isOpen = nav.classList.toggle('menu-open');
          toggle.textContent = isOpen ? '✕' : '☰';
          toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
          toggle.setAttribute('aria-expanded', String(isOpen));
        });
        // Al elegir sección, el menú vuelve a cerrarse
        nav.querySelectorAll('a').forEach(function (link) {
          link.addEventListener('click', () => {
            nav.classList.remove('menu-open');
            toggle.textContent = '☰';
            toggle.setAttribute('aria-label', 'Abrir menú');
            toggle.setAttribute('aria-expanded', 'false');
          });
        });
      });
    });
  </script>
</header>
