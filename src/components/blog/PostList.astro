---
import FormattedDate from '../FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';
import {
  blogPageUrl,
  blogPostUrl,
  postCategoryLabel,
  postFirstImage,
  readingMinutes,
  type OptimizedImage,
} from '../../lib/blog';

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  totalPages: number;
  pageUrl?: (page: number) => string;
  showCategory?: boolean;
}

const { posts, currentPage, totalPages, pageUrl = blogPageUrl, showCategory = false } = Astro.props;

// Miniaturas: primera imagen del cuerpo, optimizada en build (320px webp).
// Sin imagen o con error -> la fila sale con el hueco reservado.
const thumbs: (OptimizedImage | undefined)[] = await Promise.all(
  posts.map((post) => postFirstImage(post, 320, 240)),
);
---

<ul class="post-list">
  {posts.map((post, i) => {
    const minutes = readingMinutes(post.body);
    const url = blogPostUrl(post.id);
    const thumb = thumbs[i];
    return (
      <li class="post-item">
        {thumb ? (
          <a class="post-thumb" href={url} tabindex={-1} aria-hidden="true">
            <img
              src={thumb.src}
              width={thumb.width}
              height={thumb.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </a>
        ) : (
          <span class="post-thumb post-thumb--empty" aria-hidden="true" />
        )}
        <div class="post-text">
          <a href={url}>{post.data.title}</a>{' '}
          <span class="post-cat">
            {showCategory && <>{postCategoryLabel(post.data.categories)} · </>}
            <FormattedDate date={post.data.date} /> · {minutes} min
          </span>
          {post.data.description && <span class="post-excerpt">{post.data.description}</span>}
        </div>
      </li>
    );
  })}
</ul>

{totalPages > 1 && (
  <nav aria-label="Paginación del blog">
    <ul class="pagination">
      {currentPage > 1 && (
        <li>
          <a href={pageUrl(currentPage - 1)}>← Anterior</a>
        </li>
      )}
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
        <li>
          {page === currentPage ? (
            <span aria-current="page">{page}</span>
          ) : (
            <a href={pageUrl(page)}>{page}</a>
          )}
        </li>
      ))}
      {currentPage < totalPages && (
        <li>
          <a href={pageUrl(currentPage + 1)}>Siguiente →</a>
        </li>
      )}
    </ul>
  </nav>
)}
