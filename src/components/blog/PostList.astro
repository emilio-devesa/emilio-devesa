---
import FormattedDate from '../FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';
import { blogPageUrl, blogPostUrl, postCategoryLabel, readingMinutes } from '../../lib/blog';

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  totalPages: number;
  pageUrl?: (page: number) => string;
  showCategory?: boolean;
}

const { posts, currentPage, totalPages, pageUrl = blogPageUrl, showCategory = false } =
  Astro.props;
---

<ul class="post-list">
  {posts.map((post) => {
    const minutes = readingMinutes(post.body);
    const detail = showCategory
      ? `${postCategoryLabel(post.data.categories)} · ${minutes} min`
      : `${minutes} min`;
    return (
      <li>
        <FormattedDate date={post.data.date} />
        <a href={blogPostUrl(post.id)}>{post.data.title}</a>
        <span class="post-cat">{detail}</span>
      </li>
    );
  })}
</ul>

{totalPages > 1 && (
  <nav aria-label="Paginación del blog">
    <ul class="pagination">
      {currentPage > 1 && (
        <li>
          <a href={pageUrl(currentPage - 1)}>← Anterior</a>
        </li>
      )}
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
        <li>
          {page === currentPage ? (
            <span aria-current="page">{page}</span>
          ) : (
            <a href={pageUrl(page)}>{page}</a>
          )}
        </li>
      ))}
      {currentPage < totalPages && (
        <li>
          <a href={pageUrl(currentPage + 1)}>Siguiente →</a>
        </li>
      )}
    </ul>
  </nav>
)}
