---
import FormattedDate from '../FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { blogPageUrl, blogPostUrl, postCategoryLabel, readingMinutes } from '../../lib/blog';

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  totalPages: number;
  pageUrl?: (page: number) => string;
  showCategory?: boolean;
}

const { posts, currentPage, totalPages, pageUrl = blogPageUrl, showCategory = false } =
  Astro.props;

// Miniaturas: primera imagen del cuerpo, optimizada en build (320px webp).
// Sin imagen o con error -> la fila sale sin miniatura.
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../content/**/*.{jpg,jpeg,png,gif,webp}',
);

function firstImage(body: string | undefined): string | undefined {
  const match = /!\[[^\]]*\]\(([^)]+)\)/.exec(body ?? '');
  const rel = match?.[1].split('#')[0].trim();
  return rel && !/^(https?:|data:)/i.test(rel) ? rel : undefined;
}

interface Thumb {
  src: string;
  width: number;
  height: number;
}

const thumbs: (Thumb | undefined)[] = await Promise.all(
  posts.map(async (post) => {
    const rel = firstImage(post.body);
    if (!rel) return undefined;
    const dir = (post.filePath ?? '').replace(/^src\//, '').split('/').slice(0, -1).join('/');
    const key = `../../${dir}/${rel}`;
    const load = imageModules[key];
    if (!load) return undefined;
    try {
      const mod = await load();
      const img = await getImage({
        src: mod.default,
        width: 320,
        height: 240,
        fit: 'cover',
        format: 'webp',
      });
      return { src: img.src, width: img.attributes.width, height: img.attributes.height };
    } catch {
      return undefined;
    }
  }),
);
---

<ul class="post-list">
  {posts.map((post, i) => {
    const minutes = readingMinutes(post.body);
    const url = blogPostUrl(post.id);
    const thumb = thumbs[i];
    return (
      <li class="post-item">
        {thumb ? (
          <a class="post-thumb" href={url} tabindex={-1} aria-hidden="true">
            <img
              src={thumb.src}
              width={thumb.width}
              height={thumb.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </a>
        ) : (
          <span class="post-thumb post-thumb--empty" aria-hidden="true" />
        )}
        <div class="post-text">
          <a href={url}>{post.data.title}</a>{' '}
          <span class="post-cat">
            {showCategory && <>{postCategoryLabel(post.data.categories)} · </>}
            <FormattedDate date={post.data.date} /> · {minutes} min
          </span>
          {post.data.description && <span class="post-excerpt">{post.data.description}</span>}
        </div>
      </li>
    );
  })}
</ul>

{totalPages > 1 && (
  <nav aria-label="Paginación del blog">
    <ul class="pagination">
      {currentPage > 1 && (
        <li>
          <a href={pageUrl(currentPage - 1)}>← Anterior</a>
        </li>
      )}
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
        <li>
          {page === currentPage ? (
            <span aria-current="page">{page}</span>
          ) : (
            <a href={pageUrl(page)}>{page}</a>
          )}
        </li>
      ))}
      {currentPage < totalPages && (
        <li>
          <a href={pageUrl(currentPage + 1)}>Siguiente →</a>
        </li>
      )}
    </ul>
  </nav>
)}
