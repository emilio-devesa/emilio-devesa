---
import FormattedDate from '../FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';
import {
  blogPageUrl,
  blogPostUrl,
  postCategoryLabel,
  postFirstImage,
  readingMinutes,
  type OptimizedImage,
} from '../../lib/blog';
import { THUMB_WIDTH, THUMB_HEIGHT } from '../../lib/constants';

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  totalPages: number;
  pageUrl?: (page: number) => string;
  // false por defecto a propósito: documenta el comportamiento base aunque
  // hoy todos los llamadores pasen true.
  showCategory?: boolean;
  // Marca la lista como contenido estático del buscador (BlogLayout la oculta
  // mientras hay resultados). Solo la lleva el índice del blog.
  searchStatic?: boolean;
}

const {
  posts,
  currentPage,
  totalPages,
  pageUrl = blogPageUrl,
  showCategory = false,
  searchStatic = false,
} = Astro.props;

// Miniaturas: primera imagen del cuerpo, optimizada en build (THUMB_WIDTH px
// webp). Sin imagen o con error -> la fila sale con el hueco reservado.
const thumbs: (OptimizedImage | undefined)[] = await Promise.all(
  posts.map((post) => postFirstImage(post, THUMB_WIDTH, THUMB_HEIGHT)),
);
---

<ul class="post-list" data-pagefind-ignore data-search-static={searchStatic || undefined}>
  {posts.map((post, i) => {
    const minutes = readingMinutes(post.body);
    const url = blogPostUrl(post.id);
    const thumb = thumbs[i];
    return (
      <li class="post-item" lang={post.data.lang ?? undefined}>
        <a class="post-card" href={url}>
          {thumb ? (
            <span class="post-thumb">
              {/* Decorativa: el título visible ya está junto a la imagen. */}
              <img
                src={thumb.src}
                width={thumb.width}
                height={thumb.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </span>
          ) : (
            <span class="post-thumb post-thumb--empty" />
          )}
          <span class="post-text">
            <span class="post-title">{post.data.title}</span>
            {post.data.description && <span class="post-excerpt">{post.data.description}</span>}
            <span class="post-meta">
              {showCategory && <>{postCategoryLabel(post.data.categories)} · </>}
              <FormattedDate date={post.data.date} lang={post.data.lang ?? 'es'} /> · {minutes} min
            </span>
          </span>
        </a>
      </li>
    );
  })}
</ul>

{totalPages > 1 && (
  <nav aria-label="Paginación del blog" data-search-static={searchStatic || undefined}>
    <ul class="pagination">
      {currentPage > 1 && (
        <li>
          <a href={pageUrl(currentPage - 1)}>← Anterior</a>
        </li>
      )}
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
        <li>
          {page === currentPage ? (
            <span aria-current="page">{page}</span>
          ) : (
            <a href={pageUrl(page)}>{page}</a>
          )}
        </li>
      ))}
      {currentPage < totalPages && (
        <li>
          <a href={pageUrl(currentPage + 1)}>Siguiente →</a>
        </li>
      )}
    </ul>
  </nav>
)}
