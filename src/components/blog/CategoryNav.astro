---
import { BLOG_CATEGORIES, blogCategoryUrl, blogPageUrl } from '../../lib/blog';

interface Props {
  // slug de la categoría activa ('todo' para todas)
  active?: string;
}

const { active = 'todo' } = Astro.props;
---

<nav aria-label="Filtrar entradas por categoría" data-search-static>
  <ul class="category-filter">
    <li>
      {active === 'todo' ? (
        <span aria-current="page">Todo</span>
      ) : (
        <a href={blogPageUrl(1)}>Todo</a>
      )}
    </li>
    {BLOG_CATEGORIES.map((cat) => (
      <li>
        {active === cat.slug ? (
          <span aria-current="page">{cat.label}</span>
        ) : (
          <a href={blogCategoryUrl(cat.slug)}>{cat.label}</a>
        )}
      </li>
    ))}
  </ul>
</nav>
