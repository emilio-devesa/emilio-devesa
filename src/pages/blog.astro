---
import BlogLayout from '../layouts/BlogLayout.astro';

import { getAllPosts, paginate } from '../lib/blog';

const allPosts = await getAllPosts();

const { posts, currentPage, totalPages } = paginate(allPosts, 1);
---

<BlogLayout
  title="Blog"
  description="Entradas del blog de Emilio Devesa: hardware, software y videojuegos (algunas en inglés)."
  activeCategory="todo"
  posts={posts}
  currentPage={currentPage}
  totalPages={totalPages}
  showCategory
/>
