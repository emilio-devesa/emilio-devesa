---
import PrimaryLayout from '../layouts/PrimaryLayout.astro';
import BlogHeader from '../components/blog/BlogHeader.astro';
import HeroMini from '../components/blog/HeroMini.astro';
import PostList from '../components/blog/PostList.astro';
import Footer from '../components/Footer.astro';

import { getCollection } from 'astro:content';

const PAGE_SIZE = 20;

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);
const posts = allPosts.slice(0, PAGE_SIZE);
---

<PrimaryLayout title="Blog" robots="noindex, nofollow">
  <BlogHeader />

  <HeroMini title="Emilio Devesa" />

  <section id="posts">
    <h2>Entradas</h2>
    <PostList posts={posts} currentPage={1} totalPages={totalPages} />
  </section>

  <Footer />
</PrimaryLayout>
