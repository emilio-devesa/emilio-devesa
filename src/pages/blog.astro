---
import PrimaryLayout from '../layouts/PrimaryLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroMini from '../components/HeroMini.astro';
import PostList from '../components/blog/PostList.astro';
import SiteFooter from '../components/SiteFooter.astro';

import { getCollection } from 'astro:content';
import { BLOG_PAGE_SIZE } from '../lib/blog';

const navLinks = [
  { href: '/blog', label: 'Blog' },
  { href: 'https://github.com/emilio-devesa', label: 'GitHub' },
];

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const totalPages = Math.ceil(allPosts.length / BLOG_PAGE_SIZE);
const posts = allPosts.slice(0, BLOG_PAGE_SIZE);
---

<PrimaryLayout title="Blog" robots="noindex, nofollow">
  <SiteHeader links={navLinks} ariaLabel="Navegación del blog" idPrefix="blog" />

  <HeroMini title="Emilio Devesa" />

  <section id="posts">
    <h2>Entradas</h2>
    <PostList posts={posts} currentPage={1} totalPages={totalPages} />
  </section>

  <SiteFooter
    links={[
      { href: '/', label: 'Inicio' },
      { href: '/blog', label: 'Blog' },
    ]}
  />
</PrimaryLayout>
