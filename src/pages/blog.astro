---
import BlogLayout from '../layouts/BlogLayout.astro';

import { BLOG_PAGE_SIZE, getAllPosts } from '../lib/blog';

const allPosts = await getAllPosts();

const totalPages = Math.ceil(allPosts.length / BLOG_PAGE_SIZE);
const posts = allPosts.slice(0, BLOG_PAGE_SIZE);
---

<BlogLayout
  title="Blog"
  description="Entradas del blog de Emilio Devesa: hardware, software y videojuegos."
  activeCategory="todo"
  posts={posts}
  currentPage={1}
  totalPages={totalPages}
  showCategory
/>
