---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import {
  blogPostUrl,
  getAllPosts,
  postCategoryLabel,
  postCategorySlug,
  postFirstImage,
  postsInSameCategory,
  readingMinutes,
} from '../../lib/blog';
import { postHeadings, type TocHeading } from '../../lib/toc';
import { SITE_FALLBACK } from '../../lib/site';
import { OG_WIDTH, OG_HEIGHT, THUMB_WIDTH, THUMB_HEIGHT } from '../../lib/constants';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  // Enlaces anterior/siguiente en orden cronológico inverso (el blog
  // lista primero lo más reciente) y hasta 3 relacionados de la misma
  // categoría, rellenando con los más recientes si hacen falta.
  return await Promise.all(
    posts.map(async (post, i) => {
      const prev = posts[i - 1];
      const next = posts[i + 1];
      const label = postCategoryLabel(post.data.categories);
      const sameCat = postsInSameCategory(posts, post.data.categories).filter(
        (p) => p.id !== post.id,
      );
      const fill = posts.filter((p) => p.id !== post.id && !sameCat.includes(p));
      // Entradas completas para reutilizar la fila de la lista (PostList)
      const relatedPosts = [...sameCat, ...fill].slice(0, 3);
      return {
        params: { slug: post.id },
        props: {
          post,
          minutes: readingMinutes(post.body),
          categoryLabel: label,
          categorySlug: postCategorySlug(post.data.categories),
          prev: prev ? { title: prev.data.title, url: blogPostUrl(prev.id) } : undefined,
          next: next ? { title: next.data.title, url: blogPostUrl(next.id) } : undefined,
          related: relatedPosts,
          headings: postHeadings(post.body),
        },
      };
    }),
  );
}

interface Props {
  post: CollectionEntry<'blog'>;
  minutes: number;
  categoryLabel: string;
  categorySlug: string;
  prev?: { title: string; url: string };
  next?: { title: string; url: string };
  related: CollectionEntry<'blog'>[];
  headings: TocHeading[];
}

const { post, minutes, categoryLabel, categorySlug, prev, next, related, headings } = Astro.props;
const { Content } = await render(post);
// OG con la primera imagen del post; si no hay, el hero por defecto
const og = await postFirstImage(post, OG_WIDTH, OG_HEIGHT);
// Miniatura para el resultado de búsqueda (mismas dimensiones que el listado).
const searchThumb = await postFirstImage(post, THUMB_WIDTH, THUMB_HEIGHT);
const site = Astro.site ?? SITE_FALLBACK;
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  lang={post.data.lang}
  minutes={minutes}
  categoryLabel={categoryLabel}
  categorySlug={categorySlug}
  prev={prev}
  next={next}
  related={related}
  headings={headings}
  ogImage={og ? new URL(og.src, site).href : undefined}
  searchThumb={searchThumb ? new URL(searchThumb.src, site).href : undefined}
>
  <Content />
</PostLayout>
