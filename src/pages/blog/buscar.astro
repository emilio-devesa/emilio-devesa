---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getAllPosts } from '../../lib/blog';

const allPosts = await getAllPosts();
---

<BlogLayout
  title="Buscar en el blog"
  description="Busca en los artículos del blog de Emilio Devesa."
  activeCategory="todo"
  posts={allPosts.slice(0, 0)}
  currentPage={1}
  totalPages={1}
>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <section data-pagefind-ignore>
    <div id="blog-search">
      <p id="blog-search-fallback">La búsqueda necesita JavaScript y el índice del sitio publicado.</p>
    </div>
  </section>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
      window.addEventListener('DOMContentLoaded', () => {
        if (typeof PagefindUI === 'undefined') return;
        document.getElementById('blog-search-fallback')?.remove();
        new PagefindUI({
        element: '#blog-search',
        showSubResults: true,
        translations: { placeholder: 'Buscar artículos…' },
      });
    });
  </script>
</BlogLayout>
