---
import BlogLayout from '../../../layouts/BlogLayout.astro';

import {
  BLOG_CATEGORIES,
  blogCategoryUrl,
  getAllPosts,
  paginate,
  postsInCategory,
} from '../../../lib/blog';

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  // Una página 1 por cada categoría del filtro
  return BLOG_CATEGORIES.map((cat) => {
    const { posts, totalPages } = paginate(postsInCategory(allPosts, cat), 1);
    return {
      params: { categoria: cat.slug },
      props: {
        cat,
        posts,
        totalPages,
      },
    };
  });
}

const { cat, posts, totalPages } = Astro.props;
---

<BlogLayout
  title={`Blog – ${cat.label}`}
  description={`Entradas del blog de Emilio Devesa sobre ${cat.label} (algunas en inglés).`}
  activeCategory={cat.slug}
  posts={posts}
  currentPage={1}
  totalPages={totalPages}
  pageUrl={(page) => blogCategoryUrl(cat.slug, page)}
  showCategory
/>
