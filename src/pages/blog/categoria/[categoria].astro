---
import BlogLayout from '../../../layouts/BlogLayout.astro';

import { BLOG_CATEGORIES, BLOG_PAGE_SIZE, blogCategoryUrl, getAllPosts } from '../../../lib/blog';

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  // Una página 1 por cada categoría del filtro
  return BLOG_CATEGORIES.map((cat) => {
    const posts = allPosts.filter((post) =>
      (post.data.categories ?? []).some((c) => cat.match.includes(c)),
    );
    const totalPages = Math.max(1, Math.ceil(posts.length / BLOG_PAGE_SIZE));
    return {
      params: { categoria: cat.slug },
      props: {
        cat,
        posts: posts.slice(0, BLOG_PAGE_SIZE),
        totalPages,
      },
    };
  });
}

const { cat, posts, totalPages } = Astro.props;
---

<BlogLayout
  title={`Blog – ${cat.label}`}
  description={`Entradas del blog de Emilio Devesa sobre ${cat.label}.`}
  activeCategory={cat.slug}
  heading={`Entradas: ${cat.label}`}
  posts={posts}
  currentPage={1}
  totalPages={totalPages}
  pageUrl={(page) => blogCategoryUrl(cat.slug, page)}
/>
