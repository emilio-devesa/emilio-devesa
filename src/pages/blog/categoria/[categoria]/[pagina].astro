---
import BlogLayout from '../../../../layouts/BlogLayout.astro';

import {
  BLOG_CATEGORIES,
  BLOG_PAGE_SIZE,
  blogCategoryUrl,
  getAllPosts,
  postsInCategory,
} from '../../../../lib/blog';

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  // La página 1 de cada categoría vive en /blog/categoria/<slug>/;
  // aquí generamos las páginas 2..N de las que las necesiten.
  return BLOG_CATEGORIES.flatMap((cat) => {
    const filtered = postsInCategory(allPosts, cat);
    const totalPages = Math.max(1, Math.ceil(filtered.length / BLOG_PAGE_SIZE));
    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
      const page = i + 2;
      return {
        params: { categoria: cat.slug, pagina: String(page) },
        props: {
          cat,
          posts: filtered.slice((page - 1) * BLOG_PAGE_SIZE, page * BLOG_PAGE_SIZE),
          currentPage: page,
          totalPages,
        },
      };
    });
  });
}

const { cat, posts, currentPage, totalPages } = Astro.props;
---

<BlogLayout
  title={`Blog – ${cat.label} – Página ${currentPage}`}
  description={`Entradas del blog de Emilio Devesa sobre ${cat.label}: página ${currentPage} de ${totalPages} (algunas en inglés).`}
  activeCategory={cat.slug}
  posts={posts}
  currentPage={currentPage}
  totalPages={totalPages}
  pageUrl={(page) => blogCategoryUrl(cat.slug, page)}
  showCategory
/>
