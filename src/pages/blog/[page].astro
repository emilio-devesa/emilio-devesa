---
import PrimaryLayout from '../../layouts/PrimaryLayout.astro';
import BlogHeader from '../../components/blog/BlogHeader.astro';
import HeroMini from '../../components/blog/HeroMini.astro';
import PostList from '../../components/blog/PostList.astro';
import Footer from '../../components/Footer.astro';

import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const PAGE_SIZE = 20;
  const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);
  // La página 1 vive en /blog/, aquí generamos 2..N
  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const page = i + 2;
    const posts = allPosts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
    return {
      params: { page: String(page) },
      props: { posts, currentPage: page, totalPages },
    };
  });
}

const { posts, currentPage, totalPages } = Astro.props;
---

<PrimaryLayout title={`Blog – Página ${currentPage}`} robots="noindex, nofollow">
  <BlogHeader />

  <HeroMini title="Emilio Devesa" />

  <section id="posts">
    <h2>Entradas</h2>
    <PostList posts={posts} currentPage={currentPage} totalPages={totalPages} />
  </section>

  <Footer />
</PrimaryLayout>
