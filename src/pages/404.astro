---
import PrimaryLayout from '../layouts/PrimaryLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroMini from '../components/HeroMini.astro';
import SiteFooter from '../components/SiteFooter.astro';

import { NOT_FOUND_NAV_LINKS } from '../lib/blog';

const navLinks = NOT_FOUND_NAV_LINKS;
---

<PrimaryLayout
  title="404 No Encontrada"
  description="Página no encontrada en emiliodevesa.com."
  robots="noindex, nofollow"
>
  <SiteHeader links={navLinks} idPrefix="notfound" slot="header" />

  <HeroMini title="Página no encontrada" />

  <section aria-label="Error 404">
    <p>Lo sentimos, la página que estás buscando no existe.</p>
    <p>
      Por favor, verifica la URL, prueba a buscar en el blog o vuelve a la{' '}
      <a href="/">página principal</a>.
    </p>
    <form class="blog-search" action="/blog/" method="get" role="search">
      <div class="blog-search-row">
        <div class="blog-search-field">
          <input
            type="search"
            class="blog-search-input"
            name="q"
            placeholder="Buscar artículos…"
            aria-label="Buscar en el blog"
            autocomplete="off"
            data-search-input
          />
          <button
            type="button"
            class="blog-search-clear"
            aria-label="Limpiar búsqueda"
            hidden
            data-search-clear
          >
            ✕
          </button>
        </div>
        <button type="submit" class="blog-search-submit">
          Buscar
        </button>
      </div>
    </form>
  </section>

  <script is:inline>
    const notfoundInput = document.querySelector('[data-search-input]');
    const notfoundClear = document.querySelector('[data-search-clear]');
    if (notfoundInput && notfoundClear) {
      const syncNotfoundClear = () =>
        notfoundClear.toggleAttribute('hidden', notfoundInput.value === '');
      notfoundInput.addEventListener('input', syncNotfoundClear);
      notfoundClear.addEventListener('click', () => {
        notfoundInput.value = '';
        syncNotfoundClear();
        notfoundInput.focus();
      });
      syncNotfoundClear();
    }
  </script>
  <SiteFooter links={[{ href: '/', label: 'Inicio' }]} slot="footer" />
</PrimaryLayout>
