---
import PrimaryLayout from '../layouts/PrimaryLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import OfferSection from '../components/OfferSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import MyCommitment from '../components/MyCommitment.astro';
import MusicSection from '../components/MusicSection.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';

const navLinks = [
  { href: '#sobre-mi', label: 'Quién soy' },
  { href: '#clases', label: 'Clases de Batería' },
  { href: '#compromiso', label: 'Mi compromiso' },
  { href: '#music', label: 'Discografía' },
  { href: '#contact', label: 'Contacto' },
];
---

<PrimaryLayout>
  <SiteHeader links={navLinks} idPrefix="home" />

  <Hero />

  <About />

  <OfferSection />

  <TestimonialsSection />

  <MyCommitment />

  <MusicSection />

  <ContactSection />

  <SiteFooter
    links={[
      { href: '/', label: 'Inicio' },
      { href: '/blog', label: 'Blog' },
    ]}
  />
</PrimaryLayout>
