---
import PrimaryLayout from '../layouts/PrimaryLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import CardsSection from '../components/CardsSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import MusicSection from '../components/MusicSection.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';

import { HOME_NAV_LINKS } from '../lib/blog';

const navLinks = HOME_NAV_LINKS;

const offers = [
  {
    icon: '🎯',
    title: 'Clases personalizadas para todos los niveles',
    description:
      'Desde principiante hasta avanzado: desarrollarás tu técnica, sonido, lenguaje y repertorio.',
  },
  {
    icon: '🔥',
    title: 'Formación moderna, práctica y enfocada a resultados',
    description:
      'Un enfoque individual, adaptado a tus objetivos, a tu forma de entender la música y a tu ritmo de aprendizaje.',
  },
  {
    icon: '🎵',
    title: 'Metodología Yamaha y materiales progresivos',
    description:
      'Te guiaré en todo momento para que puedas alcanzar tus metas musicales más ambiciosas.',
  },
];

const commitments = [
  {
    icon: '💡',
    title: 'Lo que realmente importa',
    description:
      'Me comprometo a proporcionarte todas las herramientas necesarias para convertirte en el mejor batería que puedas ser.',
  },
  {
    icon: '🏁',
    title: 'Alcanza el éxito',
    description:
      'Desde tu casa hasta el escenario: adquiere técnicas de estudio eficientes y dinámicas que maximicen tu tiempo.',
  },
  {
    title: '...y diviértete!',
    iconEnd: '💫',
    description:
      'Aprender no tiene por qué ser aburrido. Con mi enfoque lúdico disfrutarás del proceso de aprendizaje.',
  },
];
---

<PrimaryLayout>
  <SiteHeader links={navLinks} idPrefix="home" slot="header" />

  <Hero />

  <About />

  <CardsSection
    id="clases"
    icon="🚀"
    title="Clases de Batería"
    cards={offers}
    cta={[
      { text: 'Más información', url: '/clases/' },
      { text: '¿Listo para empezar?', url: '#contact' },
    ]}
  />

  <TestimonialsSection />

  <CardsSection
    id="compromiso"
    icon="🤝🏾"
    title="Mi compromiso"
    cards={commitments}
    cta={[{ text: '¿Listo para empezar?', url: '#contact' }]}
  />

  <MusicSection />

  <ContactSection />

  <SiteFooter slot="footer" />
</PrimaryLayout>
