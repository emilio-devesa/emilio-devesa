---
import PrimaryLayout from './PrimaryLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroMini from '../components/HeroMini.astro';
import CategoryNav from '../components/blog/CategoryNav.astro';
import PostList from '../components/blog/PostList.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { CollectionEntry } from 'astro:content';
import { BLOG_NAV_LINKS } from '../lib/blog';

interface Props {
  title: string;
  description: string;
  activeCategory: string;
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  totalPages: number;
  pageUrl?: (page: number) => string;
  showCategory?: boolean;
}

const {
  title,
  description,
  activeCategory,
  posts,
  currentPage,
  totalPages,
  pageUrl,
  showCategory = false,
} = Astro.props;

const navLinks = BLOG_NAV_LINKS;
---

<PrimaryLayout title={title} description={description} robots="noindex, nofollow">
  <SiteHeader links={navLinks} ariaLabel="Navegación del blog" idPrefix="blog" slot="header" />

  <HeroMini title={title} />

  <section id="posts">
    <CategoryNav active={activeCategory} />
    <div class="blog-search" data-pagefind-ignore>
      <div class="blog-search-field">
        <input
          type="search"
          id="blog-search-input"
          class="blog-search-input"
          placeholder="Buscar artículos…"
          aria-label="Buscar artículos"
          autocomplete="off"
        />
        <button
          type="button"
          id="blog-search-clear"
          class="blog-search-clear"
          aria-label="Limpiar búsqueda"
          hidden
        >
          ✕
        </button>
      </div>
      <p id="blog-search-status" class="blog-search-status" role="status" aria-live="polite"></p>
    </div>
    <PostList
      posts={posts}
      currentPage={currentPage}
      totalPages={totalPages}
      pageUrl={pageUrl}
      showCategory={showCategory}
    />
    <div id="blog-search-results" hidden></div>
    <slot />
  </section>

  <script is:inline>
    (() => {
      const input = document.getElementById('blog-search-input');
      const clearBtn = document.getElementById('blog-search-clear');
      const status = document.getElementById('blog-search-status');
      const results = document.getElementById('blog-search-results');
      const section = document.getElementById('posts');
      if (!input || !status || !results || !section) return;
      const syncClear = () => {
        if (clearBtn) clearBtn.toggleAttribute('hidden', input.value === '');
      };
      const statics = section.querySelectorAll(':scope > nav, :scope > ul.post-list');
      let pagefind = null;
      let timer = 0;
      let seq = 0; // token: descarta búsquedas antiguas si llega una nueva
      const MAX_RESULTS = 50; // tope de resultados pintados
      const escapeHtml = (s) =>
        s
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      // El excerpt de Pagefind ya viene con entidades codificadas y con <mark>
      // en las coincidencias: es seguro inyectarlo como innerHTML tal cual.
      // Sincroniza ?q= con la URL (sin recargar) para poder compartir el estado.
      function syncUrl(query) {
        const params = new URLSearchParams(window.location.search);
        if (query) params.set('q', query);
        else params.delete('q');
        const qs = params.toString();
        const url = `${window.location.pathname}${qs ? `?${qs}` : ''}${window.location.hash}`;
        window.history.replaceState(null, '', url);
      }
      async function run(query) {
        const mine = ++seq;
        if (!pagefind) {
          status.textContent = 'Cargando índice…';
          try {
            pagefind = await import('/pagefind/pagefind.js');
          } catch {
            if (mine === seq)
              status.textContent = 'La búsqueda no está disponible (falta el índice).';
            return;
          }
        }
        let items;
        try {
          const answer = await pagefind.search(query);
          items = await Promise.all(answer.results.map((r) => r.data()));
        } catch {
          if (mine === seq)
            status.textContent = 'La búsqueda no está disponible (falta el índice).';
          return;
        }
        if (mine !== seq) return; // ya hay una búsqueda más reciente en curso
        items = items.slice(0, MAX_RESULTS);
        statics.forEach((el) => el.toggleAttribute('hidden', true));
        results.toggleAttribute('hidden', false);
        status.textContent =
          items.length === 0
            ? `Sin resultados para "${query}".`
            : `${items.length} resultado${items.length === 1 ? '' : 's'} para "${query}".`;
        results.innerHTML =
          '<ul class="post-list">' +
          items
            .map((item) => {
              const thumb = item.meta.image
                ? `<span class="post-thumb"><img src="${item.meta.image}" width="320" height="240" alt="" loading="lazy" decoding="async" /></span>`
                : '<span class="post-thumb post-thumb--empty"></span>';
              return `<li class="post-item"><a class="post-card" href="${item.url}">${thumb}<span class="post-text"><span class="post-title">${escapeHtml(item.meta.title)}</span><span class="post-excerpt">${item.excerpt}</span></span></a></li>`;
            })
            .join('') +
          '</ul>';
      }
      function reset() {
        clearTimeout(timer);
        seq++; // invalida cualquier búsqueda en vuelo
        statics.forEach((el) => el.toggleAttribute('hidden', false));
        results.toggleAttribute('hidden', true);
        results.innerHTML = '';
        status.textContent = '';
      }
      input.addEventListener('input', () => {
        const query = input.value.trim();
        syncClear();
        syncUrl(query);
        clearTimeout(timer);
        if (!query) {
          reset();
          return;
        }
        timer = window.setTimeout(() => run(query), 200);
      });
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          input.value = '';
          syncClear();
          syncUrl('');
          reset();
          input.focus();
        });
      }
      // Búsqueda desde otras páginas (?q= en la URL, p. ej. la 404).
      const initial = new URLSearchParams(window.location.search).get('q');
      if (initial) {
        input.value = initial;
        syncClear();
        run(initial);
      }
    })();
  </script>
  <SiteFooter slot="footer" />
</PrimaryLayout>
