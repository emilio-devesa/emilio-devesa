---
import PrimaryLayout from './PrimaryLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroMini from '../components/HeroMini.astro';
import CategoryNav from '../components/blog/CategoryNav.astro';
import PostList from '../components/blog/PostList.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { CollectionEntry } from 'astro:content';
import { BLOG_NAV_LINKS } from '../lib/blog';

interface Props {
  title: string;
  description: string;
  activeCategory: string;
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  totalPages: number;
  pageUrl?: (page: number) => string;
  showCategory?: boolean;
}

const {
  title,
  description,
  activeCategory,
  posts,
  currentPage,
  totalPages,
  pageUrl,
  showCategory = false,
} = Astro.props;

const navLinks = BLOG_NAV_LINKS;
---

<PrimaryLayout title={title} description={description} robots="noindex, nofollow">
  <SiteHeader links={navLinks} ariaLabel="Navegación del blog" idPrefix="blog" slot="header" />

  <HeroMini title={title} />

  <section id="posts" data-search-region>
    <CategoryNav active={activeCategory} />
    <form class="blog-search" action="/blog/" method="get" role="search" data-pagefind-ignore>
      <div class="blog-search-row">
        <div class="blog-search-field">
          <input
            type="search"
            class="blog-search-input"
            name="q"
            placeholder="Buscar artículos…"
            aria-label="Buscar artículos"
            autocomplete="off"
            data-search-input
          />
          <button
            type="button"
            class="blog-search-clear"
            aria-label="Limpiar búsqueda"
            hidden
            data-search-clear
          >
            ✕
          </button>
        </div>
        <button type="submit" class="blog-search-submit">
          Buscar
        </button>
      </div>
      <p class="blog-search-status" role="status" aria-live="polite" data-search-status></p>
    </form>
    {/* Sin JS no hay Pagefind: en vez de una caja que no responde, se avisa.
        Ver el <noscript> del <head> en PrimaryLayout, que oculta la caja. */}
    <noscript>
      <p class="blog-search-noscript">
        JavaScript desactivado: la función de búsqueda no está disponible.
      </p>
    </noscript>
    <PostList
      posts={posts}
      currentPage={currentPage}
      totalPages={totalPages}
      pageUrl={pageUrl}
      showCategory={showCategory}
      searchStatic
    />
    <div hidden data-search-results></div>
    {/* Tarjeta de resultado de búsqueda (esqueleto compartido con PostList):
        el script la clona y la rellena con cada resultado. */}
    <template data-search-template>
      <li class="post-item">
        <a class="post-card" href="">
          <span class="post-thumb"></span>
          <span class="post-text">
            <span class="post-title"></span>
            <span class="post-excerpt"></span>
          </span>
        </a>
      </li>
    </template>
    <slot />
  </section>

  <script is:inline>
    (() => {
      const input = document.querySelector('[data-search-input]');
      const clearBtn = document.querySelector('[data-search-clear]');
      const status = document.querySelector('[data-search-status]');
      const results = document.querySelector('[data-search-results]');
      const section = document.querySelector('[data-search-region]');
      const template = document.querySelector('[data-search-template]');
      if (!input || !status || !results || !section || !template) return;
      // Esqueleto de la tarjeta, clonado por cada resultado.
      const cardTpl = template.content.firstElementChild;
      const syncClear = () => {
        if (clearBtn) clearBtn.toggleAttribute('hidden', input.value === '');
      };
      // Contenido estático del índice (filtro, lista y paginación): se oculta
      // mientras hay resultados. Cualquier hijo directo de la región que deba
      // ocultarse tiene que llevar data-search-static.
      const statics = section.querySelectorAll(':scope > [data-search-static]');
      let pagefind = null;
      let timer = 0;
      let seq = 0; // token: descarta búsquedas antiguas si llega una nueva
      const MAX_RESULTS = 50; // tope de resultados pintados (sin importar: ver src/lib/constants.ts)
      // Sincroniza ?q= con la URL (sin recargar) para poder compartir el estado.
      function syncUrl(query) {
        const params = new URLSearchParams(window.location.search);
        if (query) params.set('q', query);
        else params.delete('q');
        const qs = params.toString();
        const url = `${window.location.pathname}${qs ? `?${qs}` : ''}${window.location.hash}`;
        window.history.replaceState(null, '', url);
      }
      // Rellena una copia del <template> con los datos de un resultado. El
      // excerpt de Pagefind ya viene con entidades codificadas y con <mark>
      // en las coincidencias: es seguro inyectarlo como innerHTML tal cual.
      function render(items) {
        const list = document.createElement('ul');
        list.className = 'post-list';
        for (const item of items) {
          const node = cardTpl.cloneNode(true);
          const link = node.firstElementChild;
          link.href = item.url;
          link.querySelector('.post-title').textContent = item.meta.title;
          link.querySelector('.post-excerpt').innerHTML = item.excerpt;
          const thumb = link.querySelector('.post-thumb');
          if (item.meta.image) {
            const img = document.createElement('img');
            img.src = item.meta.image;
            // THUMB_WIDTH×THUMB_HEIGHT (src/lib/constants.ts); el script inline
            // no puede importar. El CSS (.post-thumb) fija el tamaño final.
            img.width = 320;
            img.height = 240;
            img.alt = '';
            img.loading = 'lazy';
            img.decoding = 'async';
            thumb.appendChild(img);
          } else {
            thumb.classList.add('post-thumb--empty');
          }
          list.appendChild(node);
        }
        results.replaceChildren(list);
      }
      async function run(query) {
        const mine = ++seq;
        if (!pagefind) {
          status.textContent = 'Cargando índice…';
          try {
            pagefind = await import('/pagefind/pagefind.js');
          } catch {
            if (mine === seq)
              status.textContent = 'La búsqueda no está disponible (falta el índice).';
            return;
          }
        }
        let items;
        try {
          const answer = await pagefind.search(query);
          items = await Promise.all(answer.results.map((r) => r.data()));
        } catch {
          if (mine === seq)
            status.textContent = 'La búsqueda no está disponible (falta el índice).';
          return;
        }
        if (mine !== seq) return; // ya hay una búsqueda más reciente en curso
        items = items.slice(0, MAX_RESULTS);
        statics.forEach((el) => el.toggleAttribute('hidden', true));
        results.toggleAttribute('hidden', false);
        status.textContent =
          items.length === 0
            ? `Sin resultados para "${query}".`
            : `${items.length} resultado${items.length === 1 ? '' : 's'} para "${query}".`;
        render(items);
      }
      function reset() {
        clearTimeout(timer);
        seq++; // invalida cualquier búsqueda en vuelo
        statics.forEach((el) => el.toggleAttribute('hidden', false));
        results.toggleAttribute('hidden', true);
        results.replaceChildren();
        status.textContent = '';
      }
      input.addEventListener('input', () => {
        const query = input.value.trim();
        syncClear();
        syncUrl(query);
        clearTimeout(timer);
        if (!query) {
          reset();
          return;
        }
        timer = window.setTimeout(() => run(query), 200); // retardo (src/lib/constants.ts)
      });
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          input.value = '';
          syncClear();
          syncUrl('');
          reset();
          input.focus();
        });
      }
      // Búsqueda desde otras páginas (?q= en la URL, p. ej. la 404).
      const initial = new URLSearchParams(window.location.search).get('q');
      if (initial) {
        input.value = initial;
        syncClear();
        run(initial);
      }
    })();
  </script>
  <SiteFooter slot="footer" />
</PrimaryLayout>
