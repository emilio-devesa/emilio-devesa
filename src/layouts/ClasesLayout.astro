---
import PrimaryLayout from './PrimaryLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroMini from '../components/HeroMini.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  idPrefix?: string;
}

const {
  title,
  description = 'Información sobre las clases presenciales de batería con Emilio Devesa.',
  idPrefix = 'clases',
} = Astro.props;

const navLinks = [
  { href: '/clases/#lessons', label: 'Clases' },
  { href: '/clases/#studio', label: 'Estudio' },
  { href: '/clases/#conditions', label: 'Condiciones' },
  { href: '/clases/#contact', label: 'Contacto' },
];

const footerLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/clases/legal/media-consent', label: 'Política sobre uso de imagen' },
  { href: '/clases/legal/privacy-policy', label: 'Política de privacidad y protección de datos' },
];
---

<PrimaryLayout title={title} description={description} robots="noindex, nofollow">
  <SiteHeader links={navLinks} idPrefix={idPrefix} slot="header" />

  <HeroMini title={title} />

  <slot />

  <SiteFooter links={footerLinks} slot="footer" />
</PrimaryLayout>
