---
import '../style.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/700.css';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  redirectTo?: string;
}

const {
  title,
  description = 'Emilio Devesa - Yamaha Music Education System Key Teacher',
  robots = 'index, follow',
  redirectTo,
} = Astro.props;
const siteTitle = 'Emilio Devesa';
const pageTitle = title ? `${title} - ${siteTitle}` : siteTitle;
const site = Astro.site ?? 'https://emiliodevesa.com';
const canonical = new URL(redirectTo ?? Astro.url.pathname, site).toString();
const ogImage = new URL('/images/hero_3a.jpeg', site).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {redirectTo && <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Emilio Devesa – Blog"
      href={new URL('/rss.xml', site).toString()}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" as="image" href="/images/hero_3a.jpeg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#0b0d13" />
    <meta name="theme-color" content="#0b0d13" />
  </head>
  <body>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
