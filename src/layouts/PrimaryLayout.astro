---
import '../style.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/700.css';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  lang?: string;
  ogImage?: string;
  ogType?: string;
  publishedTime?: string;
}

const {
  title,
  description = 'Emilio Devesa - Yamaha Music Education System Key Teacher',
  // Política anti-índice por defecto: solo la home se excepciona
  // pasando robots="index, follow" (ver index.astro).
  robots = 'noindex, nofollow',
  lang = 'es',
  ogImage: ogImageProp,
  ogType = 'website',
  publishedTime,
} = Astro.props;
const siteTitle = 'Emilio Devesa';
const pageTitle = title ? `${title} - ${siteTitle}` : siteTitle;
const site = Astro.site ?? 'https://emiliodevesa.com';
// Canónica única: siempre con barra final (ver trailingSlash en config).
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, site).toString();
const ogImage = ogImageProp ?? new URL('/images/hero_3a.webp', site).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Emilio Devesa – Blog"
      href={new URL('/rss.xml', site).toString()}
    />
    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" as="image" href="/images/hero_3a.avif" type="image/avif" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="384x384" href="/favicon/android-chrome-384x384.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon/android-chrome-512x512.png" />
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon/safari-pinned-tab.svg" color="#0b0d13" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="msapplication-TileImage" content="/favicon/mstile-150x150.png" />
    <meta name="msapplication-TileColor" content="#0b0d13" />
    <meta name="msapplication-config" content="/favicon/browserconfig.xml" />
    <meta name="theme-color" content="#0b0d13" />
    {/* Fallback sin JS del menú (SiteHeader): solo <style> es válido dentro
        de <noscript> en el <head>. Duplica a propósito reglas de la hoja
        externa para no depender de ella si falla su carga. */}
    <noscript>
      <style>
        .menu-toggle {
          display: none;
        }
        @media (max-width: 768px) {
          header nav {
            flex-wrap: wrap;
          }
          .nav-links {
            display: flex;
            flex-direction: column;
            width: 100%;
            margin-top: 1rem;
          }
        }
      </style>
    </noscript>
  </head>
  <body>
    <slot name="header" />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
