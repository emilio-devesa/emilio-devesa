---
import '../style.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/700.css';
import { canonicalUrl, SITE_FALLBACK } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  lang?: string;
  ogImage?: string;
  // Dimensiones del OG: por defecto las del hero (imagen de reserva).
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  // Idioma del contenido para og:locale (p. ej. 'en_US' en los posts en inglés).
  ogLocale?: string;
  ogType?: string;
  publishedTime?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Emilio Devesa - Yamaha Music Education System Key Teacher',
  // Política anti-índice por defecto: solo la home se excepciona
  // pasando robots="index, follow" (ver index.astro).
  robots = 'noindex, nofollow',
  lang = 'es',
  ogImage: ogImageProp,
  ogImageWidth = 1280,
  ogImageHeight = 853,
  ogImageAlt,
  ogLocale = 'es_ES',
  ogType = 'website',
  publishedTime,
  jsonLd,
} = Astro.props;
const siteTitle = 'Emilio Devesa';
const pageTitle = title ? `${title} - ${siteTitle}` : siteTitle;
const site = Astro.site ?? SITE_FALLBACK;
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const ogImage = ogImageProp ?? new URL('/images/hero_3a.webp', site).toString();
const ogImageAltText = ogImageAlt ?? description;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Emilio Devesa – Blog"
      href={new URL('/rss.xml', site).toString()}
    />
    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAltText} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAltText} />
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
    ))}
    {/* El preload sirve el AVIF del fondo de .hero (candidato a LCP); el OG usa
        el WebP a propósito, porque las redes sociales no admiten AVIF. Son
        recursos distintos, no un desajuste. */}
    <link rel="preload" as="image" href="/images/hero_3a.avif" type="image/avif" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="384x384" href="/favicon/android-chrome-384x384.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon/android-chrome-512x512.png" />
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon/safari-pinned-tab.svg" color="#0b0d13" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="msapplication-TileImage" content="/favicon/mstile-150x150.png" />
    <meta name="msapplication-TileColor" content="#0b0d13" />
    <meta name="msapplication-config" content="/favicon/browserconfig.xml" />
    <meta name="theme-color" content="#0b0d13" />
    {/* Fallback sin JS del menú (SiteHeader): solo <style> es válido dentro
        de <noscript> en el <head>. Duplica a propósito reglas de la hoja
        externa para no depender de ella si falla su carga.
        Ojo con la cascada: este bloque sale ANTES del <link> de la hoja
        externa (Astro inyecta la hoja al final del head), así que a igualdad de
        especificidad ganaría la hoja externa. Por eso los selectores llevan el
        prefijo `header` (0,1,1 frente a 0,1,0): sin él, sin JS en móvil el
        botón ☰ se queda visible pero inerte y los enlaces del menú, ocultos.
        El 768 (el punto de corte documentado en src/lib/constants.ts) no se
        puede interpolar aquí: el <style> se emite tal cual. */}
    <noscript>
      <style>
        header .menu-toggle {
          display: none;
        }
        @media (max-width: 768px) {
          header nav {
            flex-wrap: wrap;
          }
          header .nav-links {
            display: flex;
            flex-direction: column;
            width: 100%;
            margin-top: 1rem;
          }
        }
      </style>
    </noscript>
  </head>
  <body>
    <slot name="header" />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
