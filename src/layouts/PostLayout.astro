---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import PrimaryLayout from './PrimaryLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroMini from '../components/HeroMini.astro';
import PostList from '../components/blog/PostList.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { BLOG_NAV_LINKS } from '../lib/blog';

interface PostLink {
  title: string;
  url: string;
}

type Props = CollectionEntry<'blog'>['data'] & {
  minutes: number;
  categoryLabel: string;
  categorySlug: string;
  prev?: PostLink;
  next?: PostLink;
  related: CollectionEntry<'blog'>[];
  ogImage?: string;
};

const {
  title,
  description,
  date,
  lang,
  minutes,
  categoryLabel,
  categorySlug,
  prev,
  next,
  related,
  ogImage,
} = Astro.props;
const articleLang = lang ?? 'es';

const navLinks = BLOG_NAV_LINKS;
---

<PrimaryLayout
  title={title}
  description={description}
  robots="noindex, nofollow"
  lang={articleLang}
  ogImage={ogImage}
>
  <SiteHeader links={navLinks} ariaLabel="Navegación del blog" idPrefix="blog" slot="header" />

  <HeroMini title={title} />

  <section id="article-content">
    <div class="article-content" lang={articleLang}>
      <p class="article-meta">
        <a href="/blog/">← Volver al índice</a> ·{' '}
        <a href={`/blog/categoria/${categorySlug}/`}>{categoryLabel}</a> ·{' '}
        <FormattedDate date={date} /> · {minutes} min de lectura
      </p>
      <slot />

      <nav class="post-nav" aria-label="Navegación entre artículos">
        <ul>
          {prev && (
            <li>
              ← Más reciente
              <br />
              <a href={prev.url}>{prev.title}</a>
            </li>
          )}
          {next && (
            <li>
              Más antiguo →
              <br />
              <a href={next.url}>{next.title}</a>
            </li>
          )}
        </ul>
      </nav>

      {related.length > 0 && (
        <div class="post-related">
          <h3>Relacionados</h3>
          <PostList posts={related} currentPage={1} totalPages={1} showCategory />
        </div>
      )}
    </div>
  </section>

  <SiteFooter slot="footer" />
</PrimaryLayout>
