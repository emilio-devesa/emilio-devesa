---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import PrimaryLayout from './PrimaryLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroMini from '../components/HeroMini.astro';
import PostList from '../components/blog/PostList.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface PostLink {
  title: string;
  url: string;
}

type Props = CollectionEntry<'blog'>['data'] & {
  minutes: number;
  categoryLabel: string;
  categorySlug: string;
  prev?: PostLink;
  next?: PostLink;
  related: CollectionEntry<'blog'>[];
};

const { title, date, minutes, categoryLabel, categorySlug, prev, next, related } = Astro.props;

const navLinks = [
  { href: '/blog', label: 'Blog' },
  { href: 'https://github.com/emilio-devesa', label: 'GitHub' },
];
---

<PrimaryLayout title={title} robots="noindex, nofollow">
  <SiteHeader links={navLinks} ariaLabel="Navegación del blog" idPrefix="blog" />

  <HeroMini title="Emilio Devesa" />

  <section id="article-content">
    <div class="article-content">
      <h2>{title}</h2>
      <p class="article-meta">
        <a href="/blog/">← Volver al índice</a> ·{' '}
        <a href={`/blog/categoria/${categorySlug}/`}>{categoryLabel}</a> ·{' '}
        <FormattedDate date={date} /> · {minutes} min de lectura
      </p>
      <slot />

      <nav class="post-nav" aria-label="Navegación entre artículos">
        <ul>
          {prev && (
            <li>
              ← Anterior
              <br />
              <a href={prev.url}>{prev.title}</a>
            </li>
          )}
          {next && (
            <li>
              Siguiente →
              <br />
              <a href={next.url}>{next.title}</a>
            </li>
          )}
        </ul>
      </nav>

      {related.length > 0 && (
        <section class="post-related">
          <h3>Relacionados</h3>
          <PostList posts={related} currentPage={1} totalPages={1} showCategory />
        </section>
      )}
    </div>
  </section>

  <SiteFooter
    links={[
      { href: '/', label: 'Inicio' },
      { href: '/blog', label: 'Blog' },
    ]}
  />
</PrimaryLayout>
