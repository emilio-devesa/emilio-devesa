---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import PrimaryLayout from './PrimaryLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroMini from '../components/HeroMini.astro';
import PostList from '../components/blog/PostList.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { BLOG_NAV_LINKS, blogCategoryUrl, blogPageUrl } from '../lib/blog';
import { canonicalUrl } from '../lib/site';
import { OG_WIDTH, OG_HEIGHT } from '../lib/constants';
import type { TocHeading } from '../lib/toc';

interface PostLink {
  title: string;
  url: string;
}

type Props = {
  title: string;
  description?: string;
  date: Date;
  lang?: string;
  minutes: number;
  categoryLabel: string;
  categorySlug: string;
  prev?: PostLink;
  next?: PostLink;
  related: CollectionEntry<'blog'>[];
  ogImage?: string;
  searchThumb?: string;
  headings?: TocHeading[];
};

const {
  title,
  description,
  date,
  lang,
  minutes,
  categoryLabel,
  categorySlug,
  prev,
  next,
  related,
  ogImage,
  searchThumb,
  headings = [],
} = Astro.props;
const articleLang = lang ?? 'es';

// Rótulos de la plantilla en el idioma del artículo: los posts `lang: en`
// muestran la interfaz en inglés; el resto del sitio sigue en español.
const t =
  articleLang === 'en'
    ? {
        backToIndex: '← Back to index',
        minRead: 'min read',
        newer: '← Newer',
        older: 'Older →',
        related: 'Related',
        postNav: 'Post navigation',
      }
    : {
        backToIndex: '← Volver al índice',
        minRead: 'min de lectura',
        newer: '← Más reciente',
        older: 'Más antiguo →',
        related: 'Relacionados',
        postNav: 'Navegación entre artículos',
      };

const navLinks = BLOG_NAV_LINKS;

// Datos estructurados del artículo (BlogPosting).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  ...(description ? { description } : {}),
  datePublished: date.toISOString(),
  inLanguage: articleLang,
  url: canonicalUrl(Astro.url.pathname, Astro.site),
  ...(ogImage ? { image: ogImage } : {}),
  author: { '@type': 'Person', name: 'Emilio Devesa' },
};
---

<PrimaryLayout
  title={title}
  description={description}
  robots="noindex, nofollow"
  ogImage={ogImage}
  ogImageWidth={ogImage ? OG_WIDTH : undefined}
  ogImageHeight={ogImage ? OG_HEIGHT : undefined}
  ogImageAlt={title}
  ogLocale={articleLang === 'en' ? 'en_US' : 'es_ES'}
  ogType="article"
  publishedTime={date.toISOString()}
  jsonLd={jsonLd}
>
  <SiteHeader links={navLinks} ariaLabel="Navegación del blog" idPrefix="blog" slot="header" />

  <HeroMini title={title} />

  <article
    id="article-content"
    class="article-content article-page"
    lang={articleLang}
    data-pagefind-body
  >
    <p class="article-meta">
      <a href={blogPageUrl(1)}>{t.backToIndex}</a> ·{' '}
      <a href={blogCategoryUrl(categorySlug)}>{categoryLabel}</a> ·{' '}
      <FormattedDate date={date} lang={articleLang} /> · {minutes} {t.minRead}
    </p>
    {/* Imagen del resultado de búsqueda: la miniatura 320×240 del post (no la
        OG, que pesa de más a 112 px). Si el post no tiene imagen propia se
        fija la meta `image` vacía para anular la autodetección de Pagefind
        (si no, tomaría la primera <img> del cuerpo —p. ej. la de
        «Relacionados»— y su nombre de fichero contaminaría la búsqueda). */}
    {searchThumb ? (
      <img data-pagefind-meta="image[src]" src={searchThumb} alt="" hidden />
    ) : (
      <span data-pagefind-meta="image:" hidden></span>
    )}
    <TableOfContents headings={headings} lang={articleLang} />
    <slot />

    <nav class="post-nav" aria-label={t.postNav} data-pagefind-ignore>
      <ul>
        {prev && (
          <li>
            {t.newer}
            <br />
            <a href={prev.url}>{prev.title}</a>
          </li>
        )}
        {next && (
          <li>
            {t.older}
            <br />
            <a href={next.url}>{next.title}</a>
          </li>
        )}
      </ul>
    </nav>

    {related.length > 0 && (
      <div class="post-related" data-pagefind-ignore>
        <h2>{t.related}</h2>
        <PostList posts={related} currentPage={1} totalPages={1} showCategory />
      </div>
    )}
  </article>

  <SiteFooter slot="footer" />
</PrimaryLayout>
