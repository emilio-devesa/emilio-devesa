---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import PrimaryLayout from './PrimaryLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroMini from '../components/HeroMini.astro';
import PostList from '../components/blog/PostList.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { BLOG_NAV_LINKS } from '../lib/blog';
import type { TocHeading } from '../lib/toc';

interface PostLink {
  title: string;
  url: string;
}

type Props = {
  title: string;
  description?: string;
  date: Date;
  lang?: string;
  minutes: number;
  categoryLabel: string;
  categorySlug: string;
  prev?: PostLink;
  next?: PostLink;
  related: CollectionEntry<'blog'>[];
  ogImage?: string;
  headings?: TocHeading[];
};

const {
  title,
  description,
  date,
  lang,
  minutes,
  categoryLabel,
  categorySlug,
  prev,
  next,
  related,
  ogImage,
  headings = [],
} = Astro.props;
const articleLang = lang ?? 'es';

const navLinks = BLOG_NAV_LINKS;
---

<PrimaryLayout
  title={title}
  description={description}
  robots="noindex, nofollow"
  ogImage={ogImage}
  ogType="article"
  publishedTime={date.toISOString()}
>
  <SiteHeader links={navLinks} ariaLabel="Navegación del blog" idPrefix="blog" slot="header" />

  <HeroMini title={title} />

  <article
    id="article-content"
    class="article-content article-page"
    lang={articleLang}
    data-pagefind-body
  >
    <p class="article-meta">
      <a href="/blog/">← Volver al índice</a> ·{' '}
      <a href={`/blog/categoria/${categorySlug}/`}>{categoryLabel}</a> ·{' '}
      <FormattedDate date={date} /> · {minutes} min de lectura
    </p>
    {/* Imagen del resultado de búsqueda. Si el post no tiene imagen propia se
        fija la meta `image` vacía para anular la autodetección de Pagefind
        (si no, tomaría la primera <img> del cuerpo —p. ej. la de
        «Relacionados»— y su nombre de fichero contaminaría la búsqueda). */}
    {ogImage ? (
      <img data-pagefind-meta="image[src]" src={ogImage} alt="" aria-hidden="true" hidden />
    ) : (
      <span data-pagefind-meta="image:" hidden aria-hidden="true"></span>
    )}
    <TableOfContents headings={headings} lang={articleLang} />
    <slot />

    <nav class="post-nav" aria-label="Navegación entre artículos" data-pagefind-ignore>
      <ul>
        {prev && (
          <li>
            ← Más reciente
            <br />
            <a href={prev.url}>{prev.title}</a>
          </li>
        )}
        {next && (
          <li>
            Más antiguo →
            <br />
            <a href={next.url}>{next.title}</a>
          </li>
        )}
      </ul>
    </nav>

    {related.length > 0 && (
      <div class="post-related" data-pagefind-ignore>
        <h2>Relacionados</h2>
        <PostList posts={related} currentPage={1} totalPages={1} showCategory />
      </div>
    )}
  </article>

  <SiteFooter slot="footer" />
</PrimaryLayout>
