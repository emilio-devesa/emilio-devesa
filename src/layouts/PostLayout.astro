---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import PrimaryLayout from './PrimaryLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroMini from '../components/HeroMini.astro';
import SiteFooter from '../components/SiteFooter.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, date } = Astro.props;

const navLinks = [
  { href: '/blog', label: 'Blog' },
  { href: 'https://github.com/emilio-devesa', label: 'GitHub' },
];
---

<PrimaryLayout title={title} robots="noindex, nofollow">
  <SiteHeader links={navLinks} ariaLabel="Navegación del blog" idPrefix="blog" />

  <HeroMini title="Emilio Devesa" />

  <section id="article-content">
    <div class="article-content max-w-2xl w-full px-4">
      <h2>{title}</h2>
      <p>
        <FormattedDate date={date} />
      </p>
      <slot />
    </div>
  </section>

  <SiteFooter
    links={[
      { href: '/', label: 'Inicio' },
      { href: '/blog', label: 'Blog' },
    ]}
  />
</PrimaryLayout>
